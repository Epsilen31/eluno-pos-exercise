{
  "info": {
    "name": "Eluno Till — Must flow",
    "description": "Run in order against python run.py. Quote sets cart/total/reference; checkout sets orderId. Running checkout again reuses the same reference. Re-run quote to start another bill.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key":"base","value":"http://localhost:8080"},{"key":"date","value":"2026-10-26"}],
  "item": [
    {"name":"1. Customer + latest valid prescription","request":{"method":"GET","url":"{{base}}/api/customers/lookup?phone=%2B919000000005"}},
    {"name":"2. Catalog / lens matrix","request":{"method":"GET","url":"{{base}}/api/catalog"}},
    {"name":"3. Quote cart","request":{"method":"POST","url":"{{base}}/api/cart/quote","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"phone\": \"+919000000005\",\n  \"storeCode\": \"HSR\",\n  \"staffId\": \"S105\",\n  \"channel\": \"walk_in\",\n  \"paymentMethod\": \"upi\",\n  \"pairs\": [{\"pairRef\": \"pair1\", \"frameVariantId\": 91000003, \"lensVariantId\": 91000083}]\n}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Quote succeeds', () => pm.response.to.have.status(200));","const quote = pm.response.json();","pm.collectionVariables.set('cart', pm.request.body.raw);","pm.collectionVariables.set('total', quote.totalPaise);","pm.collectionVariables.set('reference', 'postman-' + pm.variables.replaceIn('{{$guid}}'));","pm.collectionVariables.set('date', quote.date);"]}}]},
    {"name":"4. Checkout (repeat safely)","request":{"method":"POST","url":"{{base}}/api/checkouts","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"reference\": \"{{reference}}\",\n  \"cart\": {{cart}},\n  \"expectedTotalPaise\": {{total}}\n}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Invoice confirmed', () => pm.expect(pm.response.json().state).to.equal('COMPLETED'));","pm.collectionVariables.set('orderId', pm.response.json().orderId);","pm.collectionVariables.set('operationRef', pm.response.json().reference);"]}}]},
    {"name":"5. Shopify order","request":{"method":"GET","url":"{{base}}/api/orders/{{orderId}}"}},
    {"name":"6. Printable invoice","request":{"method":"GET","url":"{{base}}/api/orders/{{orderId}}/invoice"}},
    {"name":"7. Full refund (repeat safely)","request":{"method":"POST","url":"{{base}}/api/orders/{{orderId}}/refund","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"reference\": \"{{reference}}-return\",\n  \"staffId\": \"S105\",\n  \"reasonCode\": \"CHANGED_MIND\"\n}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Refund recorded', () => pm.expect(pm.response.json().state).to.equal('COMPLETED'));"]}}]},
    {"name":"8. Day-end + payment/channel splits","request":{"method":"GET","url":"{{base}}/api/reports/day-end?storeCode=HSR&date={{date}}"}},
    {"name":"9. Invoice operation audit","request":{"method":"GET","url":"{{base}}/api/operations/{{operationRef}}/audit"}},
    {"name":"10. Full local invoice ledger","request":{"method":"GET","url":"{{base}}/api/operations"}}
  ]
}
